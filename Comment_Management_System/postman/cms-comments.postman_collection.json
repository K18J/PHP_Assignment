          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Great article!\",\n  \"parent_id\": null\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/cms/pages/{{page_id}}/comments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "cms",
            "pages",
            "{{page_id}}",
            "comments"
          ]
        }
      }
    },
    {
